# super-mario-bros-35 — example configuration.
# Copy to ".env" and fill in real values. NEVER commit your real .env.

# --- Network ---
NEXTENDO_HOST=0.0.0.0:60008
AUTH_PORT=443
SECURE_PORT=60008
EAGLE_PORT=60009
NEXTENDO_PROXY_PROTOCOL=0

# --- TLS (auth + eagle both terminate TLS themselves) ---
CERT_FILE=cert.pem
KEY_FILE=key.pem

# --- Nextendo account integration ---
NEXTENDO_ACCOUNT_URL=https://nextendo.network
NEXTENDO_REQUIRE_ACCOUNT=1
NEXTENDO_REQUIRE_SIGNED_TOKEN=0

# --- Secrets (set these to strong random values in production) ---
NEXTENDO_INTERNAL_KEY=change-me
NEXTENDO_SECRET=change-me
NEXTENDO_SECRET_FILE=
# Kerberos password shared between the auth and secure endpoints.
NEXTENDO_SECURE_PASSWORD=change-me
# HMAC key that signs Eagle relay handoff tokens. Only needs to be consistent
# across restarts of THIS process (see eagle.go) — no other service reads it.
NEXTENDO_EAGLE_SIGNING_KEY=change-me
NEXTENDO_EAGLE_SIGNING_KEY_FILE=

# --- Monitoring dashboard ---
DASH_PORT=8083
DASH_TOKEN=change-me
